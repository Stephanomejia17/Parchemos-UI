# URL base de PARCHEMOS-API (incluye el prefijo /api).
# - Local:       http://localhost:3001/api
# - Staging:     https://api-staging.parchemos.com/api
# - Producción:  https://api.parchemos.com/api
#
# En producción esta variable es obligatoria: si falta, el build falla
# (ver src/shared/services/http/api-client.ts). No tiene fallback silencioso
# fuera de desarrollo para evitar que la app quede apuntando a localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
